{
  "name": "agent-revision-lab",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "A durable agent harness and workbench for changing goals, stale approvals, and uncertain tool outcomes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "tsx scripts/test-integration.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "node dist/src/server.js",
    "demo": "npm run build && tsx scripts/demo.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.4.0",
    "ajv": "8.20.0",
    "js-tiktoken": "1.0.21",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "embedded-postgres": "17.6.0-beta.15",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
